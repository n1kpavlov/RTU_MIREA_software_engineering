classDiagram
    class Личность {
        <<abstract>>
        # UUID id
        # string полноеИмя
        # string электроннаяПочта
        # string телефон
        # string роль
        + получитьПолноеИмя() string
        + получитьКонтактнуюИнформацию() string
        + имеетРазрешение(string) bool
    }

    class Спортсмен {
        - date датаРождения
        - string спортивныйРазряд
        - UUID идентификаторТренера
        - string[] историяСнаряжения
        - bool имеетАктивнуюЗадолженность
        + запроситьСнаряжение(RequestDto) UUID
        + вернутьСнаряжение(string штрихкод) bool
        + просмотретьМоеСнаряжение() List~ЕдиницаИнвентаря~
        + получитьДниПросрочки() int
    }

    class Тренер {
        - string специализация
        - string[] идентификаторыСпортсменовГруппы
        - int опытЛет
        - string ссылкаНаСертификат
        - decimal месячныйЛимитБюджета
        + создатьГрупповуюЗаявку(RequestDto) UUID
        + одобритьВозвратСпортсмена(string штрихкод) bool
        + просмотретьДолжниковГруппы() List~Спортсмен~
        + получитьОстатокБюджета() decimal
    }

    class Кладовщик {
        - string складскаяЗона
        - string макСканера
        - string началоСмены
        - string конецСмены
        - int обработаноОперацийСегодня
        + принятьТовар(ЗаказПоставщику) ДокументПриемки
        + выдатьСнаряжение(Спортсмен, string[]) ДокументВыдачи
        + переместитьВЯчейку(string штрихкод, string ячейка) bool
        + начатьИнвентаризацию() СессияИнвентаризации
    }

    class Закупщик {
        - string[] одобренныеПоставщики
        - decimal максимальнаяСуммаЗаказа
        - int опытРаботыМесяцев
        - string[] праваНаТендеры
        - string идентификаторКлючаПодписи
        + создатьЗаказПоставщику(RequestDto) ЗаказПоставщику
        + сравнитьПоставщиков(КарточкаТовара) Поставщик[]
        + отследитьСтатусДоставки(UUID) string
        + сгенерироватьОтчетПоЗакупкам(Период) ReportDto
    }

    Личность <|-- Спортсмен
    Личность <|-- Тренер
    Личность <|-- Кладовщик
    Личность <|-- Закупщик

    class КарточкаТовара {
        - UUID идентификаторТовара
        - string артикул
        - string наименование
        - string бренд
        - string модельныйГод
        - string[] размернаяСетка
        - int гарантийныйСрокМесяцев
        - decimal текущаяЦена
        + соответствуетФильтру(Фильтр) bool
        + получитьСреднююЦену() decimal
        + естьВНаличииНаСкладе() bool
    }

    class ЕдиницаИнвентаря {
        - UUID идентификаторЕдиницы
        - string штрихкод
        - date датаПроизводства
        - date датаВводаВЭксплуатацию
        - string состояние
        - UUID идентификаторТекущегоВладельца
        - UUID идентификаторЯчейкиХранения
        + назначитьСпортсмену(Спортсмен) bool
        + отметитьКакБрак(string причина) void
        + рассчитатьАмортизацию() decimal
        + получитьОбщееВремяИспользования() int
    }

    class ЯчейкаХранения {
        - UUID идентификаторЯчейки
        - string кодЯчейки
        - string номерСтеллажа
        - string зона
        - int вместимость
        - UUID идентификаторТекущегоПредмета
        + пуста() bool
        + получитьШтрихкодПредмета() string
        + зарезервировать() bool
    }

    КарточкаТовара "1" -- "*" ЕдиницаИнвентаря : описывает
    ЕдиницаИнвентаря "1" -- "0..1" ЯчейкаХранения : размещена_в

    class ДоговорПоставки {
        - UUID идентификаторДоговора
        - string номерДоговора
        - date датаПодписания
        - date датаОкончания
        - string наименованиеПоставщика
        - string иннПоставщика
        - string[] списокТоваров
        + действителен() bool
        + получитьОставшиесяДни() int
        + получитьЦенуНаТовар(КарточкаТовара) decimal
    }

    class ЗаявкаНаТовары {
        - UUID идентификаторЗаявки
        - date датаСоздания
        - string приоритет
        - string статус
        - UUID идентификаторАвтора
        - decimal расчетнаяСтоимость
        + отправить() void
        + отменить() bool
        + пересчитатьИтог() decimal
        + получитьЦепочкуСогласования() List~Личность~
    }

    class ЗаказПоставщику {
        - UUID идентификаторЗаказа
        - string номерЗаказа
        - date датаЗаказа
        - date срокДоставки
        - string статусДоставки
        - decimal общаяСумма
        - UUID идентификаторДоговора
        + отправитьПоставщику() bool
        + отметитьКакДоставленный() void
        + частичнаяПоставка(int количество) void
        + рассчитатьШтраф() decimal
    }

    ДоговорПоставки "1" -- "*" ЗаказПоставщику : основание
    ЗаявкаНаТовары "*" -- "1" ЗаказПоставщику : преобразована_в

    class БюджетныйСчет {
        - UUID идентификаторСчета
        - string кодБюджета
        - string центрЗатрат
        - decimal плановаяСумма
        - decimal фактическиПотрачено
        - decimal зарезервированнаяСумма
        + достаточноСредств(decimal) bool
        + зарезервировать(decimal) bool
        + зафиксировать(decimal) void
        + получитьДоступныйОстаток() decimal
    }

    class ЖурналОпераций {
        - UUID идентификаторЗаписи
        - datetime временнаяМетка
        - string идентификаторПользователя
        - string типДействия
        - string идентификаторСущности
        - string староеЗначение
        - string новоеЗначение
        + экспортироватьВСsv() string
        + отфильтроватьПоПользователю(string) List~ЖурналОпераций~
        + получитьИзмененияЗаПериод(ДиапазонДат) List
    }

    class СервисУведомлений {
        - string smtpСервер
        - string[] административныеEmail
        - string токенTelegramБота
        - int количествоRetry
        - bool включен
        + отправитьEmail(string, string, string) bool
        + отправитьPush(string, string) void
        + оповеститьПоРоли(string, string) int
        + получитьНедоставленные() List
    }

    class ГенераторОтчетов {
        - string путьШаблона
        - string выходнойФормат
        - int максимальноеКоличествоСтрок
        - string последняяОшибка
        - datetime времяПоследнегоЗапуска
        + сгенерироватьОборотнуюВедомость(Период) byte[]
        + сгенерироватьОтчетПоДолжникам() byte[]
        + сгенерироватьДинамикуЗакупок() Диаграмма
        + экспортироватьВExcel(Отчет) file
    }

    class СервисАвторизации {
        - string jwtСекрет
        - int времяЖизниТокенаЧасов
        - string[] черныйСписокТокенов
        - string ldapUrl
        - bool использоватьMfa
        + войти(string, string) ТокенАвторизации
        + проверитьРоль(UUID, string) bool
        + обновитьТокен(string) ТокенАвторизации
        + выйти(string) void
    }

    Закупщик --> СервисАвторизации : использует
    Закупщик --> ГенераторОтчетов : использует
    Кладовщик --> СервисУведомлений : использует
    Тренер --> БюджетныйСчет : проверяет
    Спортсмен --> СервисУведомлений : получает
    Закупщик --> ДоговорПоставки : управляет
    Кладовщик --> ЕдиницаИнвентаря : оперирует
    ЖурналОпераций --> Личность : записывает
    ЗаказПоставщику --> ЖурналОпераций : триггерит
    ЗаявкаНаТовары --> ЖурналОпераций : триггерит